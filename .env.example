# Optional workspace password. Leave blank for a local development environment.
APP_PASSWORD=

# Relative to the repository root.
DATA_FILE=data/state.json

# Optional OpenAI integration. The app has deterministic fallback behaviour without a key.
OPENAI_API_KEY=
OPENAI_MODEL_CHEAP=gpt-6-luna
OPENAI_MODEL_STANDARD=gpt-6.1-sol

# Optional: improves service identification/rate-limit etiquette for scholarly APIs.
OPENALEX_MAILTO=
CROSSREF_MAILTO=

# Optional: increases GitHub API limits for prior-work searches.
# Use a narrowly scoped token and never commit it.
GITHUB_TOKEN=
